# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=zs_db
DB_SSL=false
DB_LOGGING=true

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Social login (optional)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Pusher
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=mt1

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=eu-north-1
AWS_REGION=eu-north-1

# OTP
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=10

# App / Mail (Brevo)
APP_NAME="ZS Logistics"
APP_URL=http://localhost:3000
LOGOS_URL=https://media.zsparktech.com/logo.png
MAIL_API_KEY=
MAIL_FROM_NOREPLY=noreply@example.com
