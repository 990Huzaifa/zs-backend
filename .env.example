# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=zs_db
DB_SSL=false
DB_LOGGING=true

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
SOCIAL_TOKEN_ENCRYPTION_KEY=change-me-to-a-separate-long-random-secret

# Admin seeder (npm run seed:admins)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@zs.com
ADMIN_PASSWORD=Admin@123456
ADMIN_ROLE=superAdmin

# Pusher (realtime post events)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=mt1

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=eu-north-1
AWS_S3_BUCKET_NAME=

# Cron / ops (optional; if set, required as header x-cron-secret)
CRON_SECRET=
API_BASE_URL=http://localhost:3000

# OTP
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=10

# App / Mail (Brevo)
APP_NAME="ZS Logistics"
APP_URL=http://localhost:3000
LOGOS_URL=https://media.socialsyncc.com/logo.png
OAUTH_CALLBACK_DEEPLINK=socialsyncc://oauth/callback
MAIL_API_KEY=
MAIL_FROM_NOREPLY=noreply@example.com
MAIL_FROM_SUPPORT=support@example.com
MAIL_FROM_INFO=info@example.com
OWNER_EMAIL=owner@example.com


